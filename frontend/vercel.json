{
  "rewrites": [
    { 
      "source": "/sitemap.xml", 
      "destination": "https://aazhiweb.onrender.com/sitemap.xml" 
    },
    {
      "source": "/blog/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebookcatalog|Facebot|meta-externalagent|WhatsApp|whatsapp|Twitterbot|twitterbot|Pinterest|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Slackbot|slackbot|vkShare|W3C_Validator|discordapp).*"
        }
      ],
      "destination": "/api/blog-preview?slug=:slug*"
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebookcatalog|Facebot|meta-externalagent|WhatsApp|whatsapp|Twitterbot|twitterbot|Pinterest|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Slackbot|slackbot|vkShare|W3C_Validator|discordapp).*"
        }
      ],
      "destination": "/api/blog-preview"
    },
    { 
      "source": "/((?!.*\\.[^/]+$).*)", 
      "destination": "/" 
    }
  ]
}
